# ── Required: Nookplot identity ────────────────────────────────────────
# Set by `nookplot register` (see README Quickstart) — DO NOT commit real values.
NOOKPLOT_GATEWAY_URL=https://gateway.nookplot.com
NOOKPLOT_API_KEY=nk_replace_me
NOOKPLOT_AGENT_PRIVATE_KEY=0xreplace_me
NOOKPLOT_AGENT_ADDRESS=0xreplace_me

# ── Required: Venice inference (this is what the bot "thinks" with) ────
# Get a key at https://venice.ai (Settings → API). PAID: expect ~$1-2/day on
# the budget model mix, ~$8-12/day on the default Opus mix. See README
# "Models & costs" before setting DRY_RUN=false.
VENICE_API_KEY=VENICE_INFERENCE_KEY_replace_me
VENICE_BASE_URL=https://api.venice.ai/api/v1

# ── Nookplot daemon → local proxy → Venice ─────────────────────────────
# The nookplot CLI daemon POSTs OpenAI-compatible chat completions here; the
# local proxy (src/proxy.ts) handles auth/pings and forwards to Venice.
NOOKPLOT_AGENT_API_URL=http://127.0.0.1:18790/v1/chat/completions
NOOKPLOT_AGENT_API_FORMAT=openai
NOOKPLOT_AGENT_API_MODEL=grok-4-3
PROXY_PORT=18790

# ── Safety ──────────────────────────────────────────────────────────────
# KEEP true for your first runs: evaluates and logs what it WOULD do without
# firing on-chain actions or spending inference. Flip to false to go live.
DRY_RUN=true

# ── Strategy (optional) ─────────────────────────────────────────────────
# One-line description of YOUR agent's stake position, injected into the
# daemon's strategy prompt. Default assumes a fresh unstaked agent. Update it
# if/when you stake NOOK (mining payouts scale with stake tier; Tier 1 = 9M).
# BOT_STRATEGY_POSITION="Current position: Tier 1 staked (9M NOOK) — mining pays."

# ── Behavior knobs (optional; see docs/env-reference.md for all of them) ─
DEFAULT_COMMUNITY=general
OPPORTUNITY_SCAN_INTERVAL_MS=60000
MIN_BOUNTY_USDC=10

# Dashboard (npm run web): binds 127.0.0.1; set a token if you tunnel it.
WEB_PORT=7878
# WEB_AUTH_TOKEN=

# Optional: mirror generated knowledge (knowledge-vault/, observations/) to a
# local clone of a private backup repo — used by `npm run backup:knowledge`.
# KNOWLEDGE_BACKUP_DST=/path/to/your/private/backup/clone
