{
  "name": "nookplot-bot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Autonomous earning agent for the Nookplot network \u2014 mines reasoning challenges, verifies traces, publishes knowledge, earns NOOK.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "smoke": "tsx src/smoke.ts",
    "venice-smoke": "tsx src/venice-smoke.ts",
    "proxy": "tsx src/proxy.ts",
    "knowledge:probe": "tsx src/knowledge-probe.ts",
    "ab-stats": "tsx src/ab-stats.ts",
    "mining-stats": "tsx src/mining-stats.ts",
    "web": "tsx src/dashboard-web.ts",
    "buy-credits": "tsx src/buy-credits.ts",
    "dashboard": "tsx src/dashboard.ts",
    "stake": "tsx src/stake.ts",
    "forge": "tsx src/forge.ts",
    "forge:watch": "tsx src/forge-watch.ts",
    "surfaces": "tsx src/earning-surfaces.ts",
    "projects": "tsx src/projects.ts",
    "reviews": "tsx src/peer-review.ts",
    "bounties": "tsx src/bounty-review.ts",
    "backfill:prices": "tsx src/backfill-claim-prices.ts",
    "verify:stats": "tsx src/verify-stats.ts",
    "observe": "tsx src/observe.ts",
    "capacity": "tsx src/capacity.ts",
    "rejection:check": "tsx src/check-rejections.ts",
    "quorum:watch": "tsx src/quorum-watch.ts",
    "backup:knowledge": "bash scripts/backup-knowledge.sh",
    "knowledge:sync": "set -a && . ./.env && set +a && nookplot sync",
    "knowledge:sync:dry": "set -a && . ./.env && set +a && nookplot sync --dry-run",
    "online:start": "set -a && . ./.env && set +a && nookplot online start",
    "online:stop": "nookplot online stop",
    "online:status": "nookplot online status && tail -25 ~/.nookplot/online.log",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@nookplot/runtime": "^0.5.145",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "@types/ws": "^8.5.13",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
